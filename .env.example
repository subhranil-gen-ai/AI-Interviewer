# ==============================================================================
# AI INTERVIEWER PLATFORM - ENVIRONMENT CONFIGURATION EXAMPLE
# Copy this file to .env and set your API keys before running in production/Colab
# ==============================================================================

# Django Configuration
DJANGO_SECRET_KEY=replace-with-a-secure-random-50-char-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,.ngrok-free.app,.trycloudflare.com,.loca.lt

# FastAPI AI Microservice Connection
FASTAPI_SERVICE_URL=http://127.0.0.1:8001
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8001

# Configurable LLM Provider ("gemini" | "openai_compatible" | "auto")
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-2.5-flash

# Optional OpenAI-Compatible Provider Fallback (e.g. Groq / OpenRouter / OpenAI)
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
OPENAI_COMPAT_MODEL=gpt-4o-mini
